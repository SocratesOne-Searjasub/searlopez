---
import Icon from "./Icon.astro";
import ProjectTile from "./ProjectTile.astro";
import type { CollectionEntry } from "astro:content";

// compact is the short form used in the home page carousel: the summary is
// clamped, the highlights are left for the project page, and fewer chips show.
interface Props { project: CollectionEntry<"work">; featured?: boolean; compact?: boolean }
const { project, featured = false, compact = false } = Astro.props;
const p = project.data;
const href = `/work/${project.id}`;
---
<article class:list={["card card-interactive project", { featured, compact }]} id={`project-${project.id}`}>
  <div class="project-top">
    <ProjectTile project={p} />
    <span class:list={["badge", `badge-${p.status}`]}>{p.statusLabel}</span>
  </div>

  <div class="project-main">
    <h3 class="title-lg project-name"><a href={href} class="project-title-link">{p.name}</a></h3>
    <p class="label muted project-role">{p.role}</p>
    <p class="body project-summary">{p.summary}</p>
  </div>

  <div class="project-aside">
    {!compact && (
      <ul class="body muted project-highlights">
        {p.highlights.map((h) => <li>{h}</li>)}
      </ul>
    )}

    <ul class="chips project-stack" aria-label="Technologies">
      {p.stack.slice(0, compact ? 4 : 6).map((s) => <li class="chip">{s}</li>)}
    </ul>
  </div>

  <div class="project-foot">
    <a href={href} class="btn btn-tonal project-more" aria-label={`Learn more about ${p.name}`}>
      Learn more <Icon name="arrow-right" />
    </a>
    {p.url && (
      <a href={p.url} class="btn btn-text project-link" target="_blank" rel="noopener">
        {p.urlLabel ?? "Visit site"} <Icon name="arrow-up-right" />
      </a>
    )}
  </div>
</article>

<style>
  .project { display: flex; flex-direction: column; gap: 10px; padding: 22px; }
  .project-main, .project-aside { display: contents; }
  .project-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
  .project-name { margin-top: 2px; }
  .project-title-link { color: inherit; text-decoration: none; }
  .project-title-link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .project-title-link:hover { color: var(--primary); }
  .project-role { margin-top: -6px; }
  .project-summary { margin: 4px 0 0; }
  .project-highlights { display: grid; gap: 4px; padding-left: 1.1em; }
  .project-stack { margin-top: 6px; }
  .project-foot { position: relative; z-index: 1; margin-top: auto; padding-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .project-more { min-height: 40px; padding-inline: 18px; }

  .compact .project-summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; line-clamp: 5; overflow: hidden; }
  .compact .project-stack { margin-top: 10px; }

  @media (min-width: 960px) {
    .featured { grid-column: span 2; }

    /* The featured card is twice as wide as its neighbours, so lay its body out
       in two columns: text and buttons on the left, a tonal panel with the
       highlights and stack on the right that fills the card's full height. */
    .featured {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      grid-template-areas: "top top" "main aside" "foot aside";
      column-gap: 24px;
      row-gap: 10px;
    }
    .featured .project-top { grid-area: top; }
    .featured .project-main { grid-area: main; display: flex; flex-direction: column; gap: 10px; }
    .featured .project-foot { grid-area: foot; }
    .featured .project-aside {
      grid-area: aside;
      display: flex; flex-direction: column; gap: 18px;
      padding: 18px; margin-top: 2px;
      border-radius: var(--radius-md);
      background: var(--surface-container);
      transition: background var(--motion, 200ms ease);
    }
    .featured:hover .project-aside { background: var(--surface-container-high); }
    .featured .project-highlights { gap: 12px; }
    .featured .project-stack { margin-top: auto; }
    .featured .project-summary { max-width: 48ch; font-size: 1.0625rem; line-height: 1.6; }
  }
</style>
