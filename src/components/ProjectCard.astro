---
import Icon from "./Icon.astro";
import type { Project } from "../data/projects";

interface Props { project: Project; featured?: boolean }
const { project: p, featured = false } = Astro.props;
---
<article class:list={["card card-interactive project", { featured }]} id={`project-${p.slug}`}>
  <div class="project-top">
    <span class:list={["icon-tile", `tone-${p.tone}`]}><Icon name={p.icon} /></span>
    <span class:list={["badge", `badge-${p.status}`]}>{p.statusLabel}</span>
  </div>

  <h3 class="title-lg project-name">{p.name}</h3>
  <p class="label muted project-role">{p.role}</p>
  <p class="body project-summary">{p.summary}</p>

  <ul class="body muted project-highlights">
    {p.highlights.map((h) => <li>{h}</li>)}
  </ul>

  <ul class="chips project-stack" aria-label="Technologies">
    {p.stack.map((s) => <li class="chip">{s}</li>)}
  </ul>

  <div class="project-foot">
    {p.url ? (
      <a href={p.url} class="btn btn-text project-link" target="_blank" rel="noopener">
        {p.urlLabel ?? "Visit site"} <Icon name="arrow-up-right" />
      </a>
    ) : p.urlLabel ? (
      <span class="btn btn-text project-link is-disabled" aria-disabled="true">{p.urlLabel} soon</span>
    ) : null}
  </div>
</article>

<style>
  .project { display: flex; flex-direction: column; gap: 10px; padding: 22px; }
  .project-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
  .project-name { margin-top: 2px; }
  .project-role { margin-top: -6px; }
  .project-summary { margin: 4px 0 0; }
  .project-highlights { display: grid; gap: 4px; padding-left: 1.1em; }
  .project-stack { margin-top: 6px; }
  .project-foot { margin-top: auto; padding-top: 8px; margin-left: -12px; }
  .project-link.is-disabled { color: var(--on-surface-variant); cursor: default; }
  .project-link.is-disabled::after { display: none; }

  @media (min-width: 960px) {
    .featured { grid-column: span 2; }
    .featured .project-summary { max-width: 64ch; }
  }
</style>
