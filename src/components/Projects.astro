---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
---
<section id="work" class="section container" aria-labelledby="work-title">
  <div class="section-head">
    <p class="eyebrow">Work</p>
    <h2 id="work-title" class="headline">Products I have built and systems I have modernized</h2>
    <p class="body-lg muted">
      Side ventures shipped end to end under Socrates ONE, plus the federal lending platforms I work on by day.
    </p>
  </div>
  <div class="grid grid-2 grid-3">
    {projects.map((p, i) => <ProjectCard project={p} featured={i === 0} />)}
  </div>
</section>
