---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---
<section id="contact" class="section container" aria-labelledby="contact-title">
  <div class="card contact">
    <div class="contact-copy">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title" class="headline">Let's build something that works</h2>
      <p class="body-lg">
        Open to senior full-stack and platform roles, fintech conversations, and the occasional side project.
        The fastest way to reach me is email.
      </p>
    </div>
    <div class="contact-actions">
      <a href={`mailto:${site.email}`} class="btn btn-filled"><Icon name="mail" /> {site.email}</a>
      <a href={site.linkedin} class="btn btn-outlined" target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn</a>
      <a href={site.github} class="btn btn-outlined" target="_blank" rel="me noopener"><Icon name="github" /> GitHub</a>
      <a href={site.resumePdf} download={site.resumeFileName} class="btn btn-text"><Icon name="download" /> Resume PDF</a>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid; gap: 24px; padding: clamp(24px, 4vw, 48px);
    border-radius: var(--radius-xl);
    background: var(--primary-container); color: var(--on-primary-container);
  }
  .contact .eyebrow { color: inherit; opacity: 0.8; }
  .contact-copy { max-width: 56ch; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .contact .btn-outlined { --btn-fg: var(--on-primary-container); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--on-primary-container) 40%, transparent); }
  .contact .btn-text { --btn-fg: var(--on-primary-container); }
  @media (min-width: 900px) {
    .contact { grid-template-columns: 1.2fr 1fr; align-items: center; }
    .contact-actions { justify-content: flex-end; }
  }
  @media (max-width: 480px) {
    .contact-actions .btn { width: 100%; }
    .contact .btn-filled { font-size: 0.875rem; }
  }
</style>
